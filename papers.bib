@article{roper_incorporating_2023,
	title = {Incorporating diminishing returns to opportunities in access: {Development} of an open-source walkability index based on multi-activity accessibility},
	volume = {16},
	issn = {1938-7849},
	shorttitle = {Incorporating diminishing returns to opportunities in access},
	url = {https://jtlu.org/index.php/jtlu/article/view/2308},
	doi = {10.5198/jtlu.2023.2308},
	abstract = {In this paper, we argue for an explicit decoupling of “walkability” and “walking behavior” and for the advantages of a definition of walkability based on access. This provides impetus for a new approach to constructing and using walkability indices, combining accessibility theory with a goal of comprehensiveness and communicability. Diminishing returns-toopportunities can be used to map the infinite origin-destination gravity potential space to a finite scale thus creating an easily communicable metric, or metrics. In addition, this method can be applied to any mode and applied to multiple destination types singly or combined. Application of this theoretical approach is demonstrated through the creation of a novel comprehensive open-source transport walking potential index, WalkTHERE. A 0-100 scale is used to represent the percentage of people’s total needs potentially accessible by walking. The index is applied to eight Australian and two European cities, and the specific data considerations and parameters chosen are described. Significant disparity is shown in walking access between different destinations within cities, and in walking access between cities. Walking access to recreational opportunities is highest, followed by education and shopping, with very little employment access for most residents. Avenues for expansion and further validation are discussed.},
	language = {en},
	number = {1},
	urldate = {2023-10-26},
	journal = {Journal of Transport and Land Use},
	author = {Roper, Josephine and Ng, Matthew and Pettit, Christopher},
	month = oct,
	year = {2023},
	pages = {361--387},
	file = {Roper et al. - 2023 - Incorporating diminishing returns to opportunities.pdf:C\:\\Users\\z3258367\\Zotero\\storage\\H7R6CHQ8\\Roper et al. - 2023 - Incorporating diminishing returns to opportunities.pdf:application/pdf},
}

@article{roper_participatory_2024,
	title = {A participatory mapping approach to capturing perceived walkability},
	volume = {186},
	doi = {https://doi.org/10.1016/j.tra.2024.104133},
	abstract = {We present a novel method for capturing citizens’ views on perceived walkability. Peoples’ de­cisions to use any transport mode are determined by perceived accessibility, thus perceived walkability is vital to the decision to walk for transport. To date, approaches to understanding perceived walkability, such as detailed ‘walkability audit’ instruments, have been difficult to scale and linked only to respondents’ residential locations. In contrast our research uses an online mapping tool designed to rapidly capture vague knowledge about places. Respondents use a map interface to spray-paint the most and least walkable areas across the city of Sydney, Australia, along with defining the area they regularly walk from home and where they would be willing to walk. They also provide free-text input to explain their responses. This approach enables data collection of respondents’ holistic understanding of the walkability of different areas based on the local knowledge and experience of the city. Pilot results together with qualitative analysis of text submitted in response to open ended questions are presented to demonstrate the feasibility, face validity and potential of the method. A comparison with an accessibility-based walkability index, WalkTHERE, for Sydney is shown. Results are broadly aligned, but the perceived walkability results presented highlight the negative environmental quality of walking near high-traffic roads and the positive aspects of natural and water views, which are not captured in this walkability index. Perceived walkable areas around the home were on average similar in overall area to the common standard of 15-minute buffers, but longer in their longest dimension, and have irregular shapes. Detailed methodology for analysis of the online mapping inputs is provided. This method has potential for rapid yet rich data collection, particularly when used together with a walkability model to understand differences which can point to localised problems with walking environment quality.},
	language = {en},
	journal = {Transportation Research Part A: Policy and Practice},
	author = {Roper, Josephine and Ng, Matthew and Huck, Jonathan and Pettit, Christopher},
	year = {2024},
	file = {Roper - 2024 - A participatory mapping approach to capturing perc.pdf:C\:\\Users\\z3258367\\Zotero\\storage\\V3ITAYPN\\Roper - 2024 - A participatory mapping approach to capturing perc.pdf:application/pdf},
}

@phdthesis{roper_measuring_2024,
	type = {{PhD}},
	title = {Measuring the potential for walking for transport: development of approaches based on theories of accessibility and mapped perception data},
	copyright = {Creative Commons Attribution 4.0 International},
	shorttitle = {Measuring the potential for walking for transport},
	url = {http://hdl.handle.net/1959.4/103260},
	abstract = {Walking is the original, ubiquitous method of transport in cities, and remains the most space and energy efficient mode. High property prices suggest that many people want to live in the most walkable areas of cities. Yet walking has been consistently undervalued in city planning and particularly, transport planning. Much is known qualitatively about what makes a particular street walkable or unwalkable, yet quantitative methods to evaluate the potential to walk for transport across an entire street and destination network are overly simplistic, poorly justified or proprietary. In this thesis, walkability is examined through an access framework: how walkability can create access to destinations, and how property prices can be used to demonstrate revealed preferences for access. First, an argument is presented for the broad benefits of the potential for walking and for the potential of property price to quantify individual benefits. A novel access-based walkability index is developed that combines a communicable scale with consideration of the generalised cost of travel to a large number of destinations, using a diminishing-returns-to-opportunity approach, across multiple destination types. This index is compared to data on perceived walkability gathered through a novel map-based survey for Sydney, Australia, and the index's predictive power with respect to residential property prices is examined for house and apartment markets. Perceived walkability results are positively correlated with the index, but some areas of difference indicate that recreational walking is an important factor for general perceived walkability. When looking at property prices, walkable access was found to be more highly valued for apartment purchases than house purchases. Finally, future work possibilities are shown through demonstrating the application of the accessibility index to other modes of transport, a methodology that can allow better evaluation of the trade-offs between access by different modes in consideration of new transport projects and land-use changes. Overall, the methods developed by the research reported in this thesis contribute to advancing a more holistic approach to transport planning that can be appropriately inclusive of active transport modes.},
	language = {en},
	urldate = {2024-11-11},
	school = {UNSW Sydney},
	author = {Roper, Josephine},
	collaborator = {{UNSW Sydney}},
	year = {2024},
	doi = {10.26190/UNSWORKS/30576},
	keywords = {accessibility, walkability, Sydney, transport planning, 330409 Transport planning, 330410 Urban analysis and development, active transport, perceived accessibility, property pricing, sustainable transport},
	file = {Thesis-public-21.10.pdf:C\:\\Users\\z3258367\\Zotero\\storage\\4F62YF9R\\Thesis-public-21.10.pdf:application/pdf},
}

