
@incollection{geertman_understanding_2021,
	address = {Cham},
	title = {Understanding the {Economic} {Value} of {Walkable} {Cities}},
	isbn = {978-3-030-76058-8 978-3-030-76059-5},
	url = {https://link.springer.com/10.1007/978-3-030-76059-5_15},
	abstract = {Improving walkability has the potential to play a major role in improving both accessibility and the public health dimensions of our cities. Walkability research to-date has focused on the inﬂuence of the built environment on physical activity associated with health and active transport outcomes. While the probable desirability of walkability to real estate value is recognised by the embedding of walkability indices such as WalkScore in property listing platforms, there is a paucity of research exploring this assumption. This research addresses this gap by undertaking an empirical study to quantify the economic value of walkability to residential property. Speciﬁcally, we demonstrate the use of hedonic price modelling to test measures of walkability with a case study. We ﬁnd that WalkScore is positively related to prices for detached houses in Sydney, Australia but has no signiﬁcant relationship to unit prices. Possible reasons and directions for future work are discussed.},
	language = {en},
	urldate = {2021-08-26},
	booktitle = {Urban {Informatics} and {Future} {Cities}},
	publisher = {Springer International Publishing},
	author = {Roper, Josephine and Pettit, Christopher and Ng, Matthew},
	editor = {Geertman, S. C. M. and Pettit, Christopher and Goodspeed, Robert and Staffans, Aija},
	year = {2021},
	doi = {10.1007/978-3-030-76059-5_15},
	note = {Series Title: The Urban Book Series},
	pages = {277--299},
	file = {Roper et al. - 2021 - Understanding the Economic Value of Walkable Citie.pdf:C\:\\Users\\z3258367\\Zotero\\storage\\XF3EDHMV\\Roper et al. - 2021 - Understanding the Economic Value of Walkable Citie.pdf:application/pdf},
}

@article{roper_colouring_2022,
	title = {Colouring {Australia}: a participatory open data platform},
	volume = {X-4/W3-2022},
	issn = {2194-9050},
	shorttitle = {{COLOURING} {AUSTRALIA}},
	url = {https://www.isprs-ann-photogramm-remote-sens-spatial-inf-sci.net/X-4-W3-2022/229/2022/},
	doi = {10.5194/isprs-annals-X-4-W3-2022-229-2022},
	abstract = {Abstract. Colouring Australia is a digital platform for collecting and visualising building level information across several Australian cities. It provides a valuable resource for bringing together data on building age, material, sustainability ratings, walkability and other key metrics as we plan for net zero cities. Colouring Australia comprises part of the international Colouring Cities Research Programme, which supports the development of open-source platforms that provide open data on national building stocks. In this paper we outline the technical architecture of the platform, and the development and visualisation of a building level walkability metric based on pedestrian access to destinations. This platform provides a useful digital tool for planners to understand which parts of the city are walkable and in turn this can support future active transport programs and policies. Future research will be to validate this novel walkability index through a series of stakeholder and public workshops using the Colouring Australia platform in an interactive tabletop environment where usability testing can be undertaken.},
	language = {en},
	urldate = {2022-10-19},
	journal = {ISPRS Annals of the Photogrammetry, Remote Sensing and Spatial Information Sciences},
	author = {Roper, Josephine and Hudson, Polly and Petersen, Henry and Pettit, Chris and Russell, Thomas and Ng, Matthew},
	month = oct,
	year = {2022},
	pages = {229--235},
	file = {Roper et al. - 2022 - COLOURING AUSTRALIA A PARTICIPATORY OPEN DATA PLA.pdf:C\:\\Users\\z3258367\\Zotero\\storage\\9AVKKKUL\\Roper et al. - 2022 - COLOURING AUSTRALIA A PARTICIPATORY OPEN DATA PLA.pdf:application/pdf},
}

@article{ng_reflection_2022,
	title = {The {Reflection} of {Income} {Segregation} and {Accessibility} {Cleavages} in {Sydney}’s {House} {Prices}},
	volume = {11},
	issn = {2220-9964},
	url = {https://www.mdpi.com/2220-9964/11/7/413},
	doi = {10.3390/ijgi11070413},
	abstract = {Cities often show residential income segregation, and the price of housing is generally related to employment accessibility, but how do these factors intersect? We analyse Greater Sydney, Australia, a metropolitan area of 5 million people. Sydney is found to have reasonably even employment accessibility by car, reﬂecting the increasingly polycentric nature of the modern city; however, it also shows considerable income segregation and variance in property prices between different parts of the city. Entropy is used to examine diversity and mixing of different income groups. Finally, hedonic price models using ordinary-least squares and geographically-weighted regression techniques show the differing effects of employment accessibility on house prices in different parts of the city. The results show that accessibility has small to negative effects on prices in the most valuable areas, suggesting that other effects such as recreational access and employment type/quality may be more important determinants of house prices in these areas.},
	language = {en},
	number = {7},
	urldate = {2022-11-27},
	journal = {ISPRS International Journal of Geo-Information},
	author = {Ng, Matthew Kok Ming and Roper, Josephine and Lee, Chyi Lin and Pettit, Christopher},
	month = jul,
	year = {2022},
	pages = {413},
	file = {Ng et al. - 2022 - The Reflection of Income Segregation and Accessibi.pdf:C\:\\Users\\z3258367\\Zotero\\storage\\I6U8FVAR\\Ng et al. - 2022 - The Reflection of Income Segregation and Accessibi.pdf:application/pdf},
}

